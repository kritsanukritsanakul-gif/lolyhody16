        <circle cx="50" cy="40" r="25" fill="#2563eb" stroke="#1d4ed8" strokeWidth="1.5"/>
        <rect x="35" y="65" width="30" height="35" rx="4" fill="#1d4ed8"/>
        <circle cx="42" cy="38" r="3.5" fill="#1e3a8a"/>
        <circle cx="58" cy="38" r="3.5" fill="#1e3a8a"/>
