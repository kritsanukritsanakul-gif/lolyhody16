        <path d="M50 85 Q30 85 30 68 Q30 52 50 52 Q70 52 70 68 Q70 85 50 85" fill="#ef4444" opacity="0.8"/>
        <circle cx="42" cy="38" r="3.5" fill="#7f1d1d"/>
