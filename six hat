        <rect x="30" y="65" width="40" height="30" rx="4" fill="#1e293b"/>
        <circle cx="42" cy="38" r="3" fill="#f8fafc"/>
        <circle cx="58" cy="38" r="3" fill="#f8fafc"/>
      </svg>
    ),
    yellow: (
      <svg viewBox="0 0 100 100" className="w-full h-full drop-shadow-md">
        <circle cx="50" cy="40" r="25" fill="#fbbf24" stroke="#d97706" strokeWidth="1.5"/>
        <circle cx="42" cy="38" r="3.5" fill="#78350f"/>
        <circle cx="58" cy="38" r="3.5" fill="#78350f"/>
        <path d="M38 50 Q50 62 62 50" stroke="#78350f" fill="none" strokeWidth="3" strokeLinecap="round"/>
      </svg>
    ),
    green: (
      <svg viewBox="0 0 100 100" className="w-full h-full drop-shadow-md">
        <circle cx="50" cy="40" r="25" fill="#10b981" stroke="#047857" strokeWidth="1.5"/>
        <circle cx="42" cy="38" r="3" fill="#064e3b"/>
