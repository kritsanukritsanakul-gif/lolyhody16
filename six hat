import React, { useState, useEffect, useRef } from 'react';
import { LucideCheckCircle, LucideAlertCircle, LucideSend, LucideHistory, LucideLoader2, LucideTarget, LucideTrophy, LucideUsers, LucideCrown, LucideLock, LucideHash, LucideLightbulb, LucideSparkles, LucideBrainCircuit, LucideWand2, LucideChevronDown, LucideMenu } from 'lucide-react';

// --- Constants & Config ---
const apiKey = ""; // System will provide at runtime

// --- Assets ---
const Avatar = ({ type }) => {
  const characters = {
    white: (
      <svg viewBox="0 0 100 100" className="w-full h-full drop-shadow-md">
        <circle cx="50" cy="40" r="25" fill="#f8fafc" stroke="#cbd5e1" strokeWidth="1.5"/>
        <rect x="35" y="65" width="30" height="35" rx="8" fill="#f8fafc" stroke="#cbd5e1" strokeWidth="1.5"/>
        <circle cx="42" cy="38" r="3" fill="#334155"/>
        <circle cx="58" cy="38" r="3" fill="#334155"/>
      </svg>
    ),
    red: (
      <svg viewBox="0 0 100 100" className="w-full h-full drop-shadow-md">
